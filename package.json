    "tailwindcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "vitest": "5.0.5",
    "playwright": "1.64.1",
    "eslint": "10.14.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.72.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
